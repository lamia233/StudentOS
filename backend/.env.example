# --- Server ---
PORT=4000
NODE_ENV=development
# Comma-separated list of allowed browser origins (the Vite dev server by default)
CORS_ORIGIN=http://localhost:5173
# Set when running behind a reverse proxy (e.g. 1 = trust one hop) so rate limiting sees real client IPs.
TRUST_PROXY=

# --- Database ---
# SQLite for local development. For PostgreSQL use e.g.
# postgresql://user:password@localhost:5432/studentos  (and switch the provider in prisma/schema.prisma)
DATABASE_URL="file:./dev.db"

# --- Security ---
# Long random string used to sign session JWTs. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
# Used to encrypt Notion tokens entered through the UI (AES-256-GCM). Any long random string.
ENCRYPTION_KEY=change-me-to-another-long-random-string

# --- Notion (optional) ---
# Internal integration token from https://www.notion.so/my-integrations.
# If set, it is used for Live Notion Mode and never sent to the browser.
NOTION_TOKEN=
# Default database or page ID to sync with (can also be entered in the app).
NOTION_TARGET_ID=

# --- Assistant LLM (optional) ---
# If set, StudentOS Assistant uses an OpenAI-compatible chat completion API with
# your StudentOS data as context. Without it, a deterministic data-driven assistant is used.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
